# Copy to .env on the server (never commit .env). Every value has a safe default; see server/config.ts.

# Where the HOME transporter leads (a build-time setting: rebuild after changing it).
PUBLIC_HOME_URL=https://djrecognize.com

# Players connected at once; the next one is told "Station is at capacity". Raise it only after a load test (npm run loadtest).
CELLWARZ_MAX_PLAYERS=60
# Sockets (the game plus the login screen's radar) in total and from one address.
CELLWARZ_MAX_CONNECTIONS=240
CELLWARZ_MAX_CONNECTIONS_PER_IP=8

# Wrong hashes one address may try per ten minutes (in total / against one callsign) before it is turned away.
CELLWARZ_LOGIN_FAILURES_PER_ADDRESS=20
CELLWARZ_LOGIN_FAILURES_PER_CALLSIGN=5

# Extra browser origins allowed to open a game socket (the site's own origin always is). Comma separated.
CELLWARZ_ALLOWED_ORIGINS=
# Which header names the real visitor address, for the per-address limits (everyone looks like Caddy otherwise):
#   forwarded  = Caddy's X-Forwarded-For (DNS-only record, no Cloudflare proxy) - the default setup
#   cloudflare = Cloudflare's CF-Connecting-IP (orange-cloud record; the firewall must then admit only Cloudflare, see DEPLOY.md)
#   off        = the socket's own peer (local development)
CELLWARZ_TRUST_PROXY=forwarded
# Lets the DJ Recognize site read /api/status (player count) from a browser.
CELLWARZ_STATUS_ORIGIN=https://djrecognize.com

# How often the room is saved, and how long a sleeping avatar (no connection) stays in the room.
CELLWARZ_SNAPSHOT_INTERVAL_SECONDS=10
CELLWARZ_SLEEPER_EVICT_MINUTES=30

# Callsigns nobody can claim (comma separated; case and punctuation ignored). Unset = admin, moderator, djrecognize, ...
# To claim one yourself, set this empty for one start, log in and set your hash, then remove the line again.
# CELLWARZ_RESERVED_NAMES=

# Black Box recording is a local development tool and stays off on the real site. Do not set this there.
# CELLWARZ_BLACK_BOX=off
